@model IEnumerable<ContosoUniversity.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments";
}

<h2>Enrollments</h2>
<hr />

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Grade</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Student.LastName</td>
                <td>@item.Course.Title</td>
                <td>@item.Grade</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EnrollmentID" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.EnrollmentID" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.EnrollmentID" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New Enrollment</a>