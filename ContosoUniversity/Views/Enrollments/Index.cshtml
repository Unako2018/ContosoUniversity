@model IEnumerable<BusinessObject.EnrollmentViewModel>

<h2>Enrollments</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Enrollment</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
       
            <th>Course </th>
            <th>Student </th>
            <th>Grade </th>


            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
            
                <td>@item.CourseName</td>
                <td>@item.StudentName</td>
                <td>@item.GradeName</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.EnrollmentID" class="btn btn-sm btn-warning">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.EnrollmentID" class="btn btn-sm btn-danger">Delete</a>

                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Add Enrollment</a>