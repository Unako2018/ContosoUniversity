@model BusinessObject.EnrollmentViewModel

<h2>Delete Enrollment</h2>

<h4>Are you sure you want to delete this Enrollment?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Enrollment</dt>
        <dd class="col-sm-10">@Model.CourseID</dd>
        <dd class="col-sm-10">@Model.StudentID</dd>
        <dd class="col-sm-10">@Model.GradeID</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="EnrollmentID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

