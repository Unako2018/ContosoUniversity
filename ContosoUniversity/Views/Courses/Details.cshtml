@model BusinessObject.CourseViewModel

<h2>CourseDetails</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Course</dt>
        <dt class="col-sm-10">@Model.Title</dt>

        <dt class="col-sm-2">Course</dt>
        <dt class="col-sm-10">@Model.Credits</dt>
    </dl>
</div>

<div>
