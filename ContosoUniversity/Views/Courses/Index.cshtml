@model IEnumerable<BusinessObject.CourseViewModel>

<h2>Courses</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Credits </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var grade in Model)
        {
            <tr>
                <td>@grade.Title</td>
                <td>@grade.Credits</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@grade.CourseID" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@grade.CourseID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Add Course</a>