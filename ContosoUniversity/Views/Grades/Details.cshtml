@model BusinessObject.GradeViewModel

<h2>GradeDetails</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Grade</dt>
        <dd class="col-sm-10">@Model.Grade.Name</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Grade.Description</dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.GradeID" class="btn btn-warning">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.GradeID class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>