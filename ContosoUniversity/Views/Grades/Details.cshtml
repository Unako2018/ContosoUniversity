@model ContosoUniversity.Models.Enrollment

<h2>Enrollment Details</h2>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Student</dt>
        <dd class="col-sm-10">@Model.Student.LastName</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Course.Title</dd>

        <dt class="col-sm-2">Credits</dt>
        <dd class="col-sm-10">@Model.Course.Credits</dd>

        <dt class="col-sm-2">Grade</dt>
        <dd class="col-sm-10">@Model.Grade</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.EnrollmentID" class="btn btn-warning">Edit</a>
    <a asp-action="Delete" asp-route-id="@Model.EnrollmentID" class="btn btn-danger">Delete</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>