@model BusinessObject.EnrollmentViewModel

<h2>Create Enrollment</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="StudentID">Student</label>
        <select asp-for="StudentID" class="form-control"
                asp-items="@(new SelectList(ViewData["Students"] as IEnumerable<BusinessObject.StudentViewModel>, "ID", "LastName"))">
        </select>
    </div>

    <div class="form-group">
        <label asp-for="CourseID">Course</label>
        <select asp-for="CourseID" class="form-control"
                asp-items="@(new SelectList(ViewData["Courses"] as IEnumerable<BusinessObject.CourseViewModel>, "CourseID", "Title"))">
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Grade">Grade</label>
        <select asp-for="Grade" class="form-control"
                asp-items="Html.GetEnumSelectList<ContosoUniversity.Models.Grade>()">
        </select>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</form>