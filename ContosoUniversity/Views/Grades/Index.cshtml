@model IEnumerable<BusinessObject.GradeViewModel>

<h2>Grades</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Grade</th>
            <th>Description </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var grade in Model)
        {
            <tr>
                <td>@grade.Name</td>
                <td>@grade.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@grade.GradeID" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@grade.GradeID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Add Grade</a>