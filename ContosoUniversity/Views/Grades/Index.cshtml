@model IEnumerable<ContosoUniversity.Models.Enrollment>

<h2>Grades</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Student</th>
            <th>Course</th>
            <th>Grade</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var enrollment in Model)
        {
            <tr>
                <td>@enrollment.Student.FirstMidName @enrollment.Student.LastName</td>
                <td>@enrollment.Course.Title</td>
                <td>@enrollment.Grade</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@enrollment.EnrollmentID" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@enrollment.EnrollmentID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-success">Add Enrollment with Grade</a>